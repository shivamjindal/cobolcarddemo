{
  "feature": "batch-auth-purge",
  "kind": "batch",
  "programs": [
    "CBPAUP0C"
  ],
  "install": [
    "pending-authorizations"
  ],
  "notes": "Runs as BMP CBPAUP0C with PSB PSBPAUTB (CMPAT=YES, so PCB 2 is the database PCB) and the SYSIN card from jcl/CBPAUP0J.jcl unless a case says otherwise. Expiry days 00 makes every detail expire (WS-DAY-DIFF >= WS-EXPIRY-DAYS, line 284). Pinned legacy defects: 6000-DELETE-AUTH-SUMMARY deletes the summary right after the GNP that returned GE, so the DLET gets DJ and 9999-ABEND sets RC 16; status DJ derives from the IMS rule above (EXEC DLI REPL/DLET need the immediately preceding call to have returned that segment). The summary test at line 156 checks PA-APPROVED-AUTH-CNT twice and never the declined count. The expired counts are subtracted in storage only; the summary is never replaced. The checkpoint tests at lines 160 and 360 compare a 9(8) counter with an X(5) parameter as alphanumeric, so '00001' only triggers once a counter reaches 1000: no mid-run CHKP and no 'CHKP SUCCESS' line. The deletes made before the RC 16 are kept because 9999-ABEND returns normally and the region commits.",
  "cases": [
    {
      "id": "batch-auth-purge-summary-delete-dj",
      "title": "Account 1's six details expire and are deleted; the summary DLET gets DJ and the job ends RC 16",
      "provenance": "observed",
      "source": "CBPAUP0C MAIN-PARA, 4000-CHECK-IF-EXPIRED, 5000-DELETE-AUTH-DTL, 6000-DELETE-AUTH-SUMMARY, 9999-ABEND",
      "job": {
        "program": "CBPAUP0C",
        "psb": "PSBPAUTB",
        "sysin": [
          "00,00001,00001,Y"
        ],
        "dd": {}
      },
      "expect": {
        "completion": "RC=16",
        "sysout": [
          "STARTING PROGRAM CBPAUP0C::",
          "*-------------------------------------*",
          "CBPAUP0C PARM RECEIVED :00,00001,00001,Y",
          "TODAYS DATE            :26309",
          "",
          "DEBUG: AUTH SMRY READ : +0000000000",
          "DEBUG: AUTH DTL READ : +0000000000",
          "DEBUG: AUTH DTL DLET : +00000000001",
          "DEBUG: AUTH DTL READ : +0000000001",
          "DEBUG: AUTH DTL DLET : +00000000001",
          "DEBUG: AUTH DTL READ : +0000000002",
          "DEBUG: AUTH DTL DLET : +00000000001",
          "DEBUG: AUTH DTL READ : +0000000003",
          "DEBUG: AUTH DTL DLET : +00000000001",
          "DEBUG: AUTH DTL READ : +0000000004",
          "DEBUG: AUTH DTL DLET : +00000000001",
          "DEBUG: AUTH DTL READ : +0000000005",
          "DEBUG: AUTH DTL DLET : +00000000001",
          "DEBUG: AUTH DTL READ : +0000000006",
          "DEBUG: AUTH SMRY DLET : +00000000001",
          "AUTH SUMMARY DELETE FAILED :DJ",
          "AUTH APP ID                :+00000000001",
          "CBPAUP0C ABENDING ..."
        ],
        "files": {
          "PAUTDTL1": {
            "deleted": [
              "1/76699/998747444",
              "1/76699/998748388",
              "1/76700/769089115",
              "1/76700/769090347",
              "1/76700/769091469",
              "1/76700/837391279"
            ]
          }
        }
      }
    },
