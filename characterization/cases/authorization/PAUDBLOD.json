{
  "feature": "batch-auth-load",
  "kind": "batch",
  "programs": [
    "PAUDBLOD"
  ],
  "install": [
    "pending-authorizations"
  ],
  "notes": "BMP PAUDBLOD with PSB PSBPAUTB (jcl/LOADPADB.JCL), called at its primary entry with the PSB's PCB list (I/O PCB, database PCB); ENTRY 'DLITCBL' lists only PAUTBPCB, which would bind the I/O PCB. INFILE1 and INFILE2 hold the records PAUDBUNL writes (seed roots of accounts 1 and 5, seed children of accounts 5 and 29) and the database starts empty. Pinned legacy defect: 3100-INSERT-CHILD-SEG has no END-IF after the GU success branch (lines 305-314), so a GU that fails (account 29 has no root) skips the child without a message or abend.",
  "cases": [
    {
      "id": "batch-auth-load-from-unload",
      "title": "Roots load, account 5's child loads under its root, account 29's orphan child is skipped silently",
      "provenance": "observed",
      "source": "PAUDBLOD 2100-INSERT-ROOT-SEG, 3100-INSERT-CHILD-SEG, 3200-INSERT-IMS-CALL",
      "setup": {
        "PAUTSUM0": {
          "where": {
            "PA-ACCT-ID": []
          }
        },
        "PAUTDTL1": {
          "where": {
            "PAUT-PARENT-ACCT-ID": []
          }
        }
      },
      "job": {
        "program": "PAUDBLOD",
        "psb": "PSBPAUTB",
        "dd": {
          "INFILE1": {
            "dataset": "PAUTSUM0",
            "as": "sequential",
            "seed": true,
            "where": {
              "PA-ACCT-ID": [
                "1",
                "5"
              ]
            }
          },
          "INFILE2": {
            "dataset": "PAUTDTL1",
            "as": "sequential",
            "seed": true,
            "where": {
              "PAUT-PARENT-ACCT-ID": [
                "5",
                "29"
              ]
            }
          }
        }
      },
      "expect": {
        "completion": "RC=0",
        "sysout": [
          "STARTING PAUDBLOD",
          "*-------------------------------------*",
          "TODAYS DATE            :261105",
          "",
          " *******************************",
          " *******************************",
          "ROOT INSERT SUCCESS",
