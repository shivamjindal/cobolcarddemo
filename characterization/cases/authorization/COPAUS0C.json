{
  "feature": "pending-auth-summary",
  "kind": "online",
  "programs": [
    "COPAUS0C"
  ],
  "install": [
    "pending-authorizations"
  ],
  "notes": "Pinned legacy behavior: CREDLIM and CASHLIM come from ACCTDATA (COPAUS0C lines 780-783), not from the IMS summary, so account 1 shows 2020.00 while its PAUTSUM0 limit is 2022.00. Error paths send the screen and keep going: GATHER-ACCOUNT-DETAILS (line 753) performs the xref, account and customer reads in turn, each NOTFND branch sends the screen (lines 845, 895, 946) and the next read still runs, so a missing account ends on the customer-file message. PROCESS-PAGE-FORWARD sets NEXT-PAGE-NO only when the loop ends before EOF (lines 445-451), so after the last page NEXT-PAGE-YES stays set and another PF8 shows an empty list instead of 'You are already at the bottom of the page'.",
  "cases": [
    {
      "id": "pending-auth-summary-entry",
      "title": "Menu option 11 opens the pending authorization summary with an empty account",
      "provenance": "observed",
      "source": "COMEN01C option 11 XCTL, COPAUS0C MAIN-PARA first entry",
      "steps": [
        {
          "do": {
            "transid": "CC00"
          }
        },
        {
          "do": {
            "aid": "ENTER",
            "fields": {
              "USERID": "USER0001",
              "PASSWD": "PASSWORD"
            }
          }
        },
        {
          "do": {
            "aid": "ENTER",
            "fields": {
              "OPTION": "11"
            }
          },
          "expect": {
            "map": "COPAU0A",
            "fields": {
              "TRNNAME": "CPVS",
              "PGMNAME": "COPAUS0C"
            },
            "cursor": "ACCTID"
          }
        }
      ]
    },
