{
  "feature": "batch-auth-unload",
  "kind": "batch",
  "programs": [
    "PAUDBUNL"
  ],
  "install": [
    "pending-authorizations"
  ],
  "notes": "DL/I batch PAUDBUNL with PSB PAUTBUNL (jcl/UNLDPADB.JCL). The database is cut to accounts 1 and 5 plus the seed's blank-key summary. Pinned legacy behavior: the blank-key summary is skipped by IF PA-ACCT-ID IS NUMERIC (line 232); children are counted into WS-NO-SUMRY-READ (line 268).",
  "cases": [
    {
      "id": "batch-auth-unload-flat",
      "title": "Roots go to OUTFIL1 and children with their root key to OUTFIL2, in hierarchical order",
      "provenance": "observed",
      "source": "PAUDBUNL 2000-FIND-NEXT-AUTH-SUMMARY, 3000-FIND-NEXT-AUTH-DTL",
      "setup": {
        "PAUTSUM0": {
          "where": {
            "PA-ACCT-ID": [
              "1",
              "5",
              "40404040404"
            ]
          }
        },
        "PAUTDTL1": {
          "where": {
            "PAUT-PARENT-ACCT-ID": [
              "1",
              "5"
            ]
          }
        }
      },
      "job": {
        "program": "PAUDBUNL",
        "psb": "PAUTBUNL",
        "dd": {
          "OUTFIL1": {
            "output": "ROOT",
            "reclen": 100,
            "decode_as": "PAUTSUM0"
          },
          "OUTFIL2": {
            "output": "CHILD",
            "reclen": 206,
            "decode_as": "PAUTDTL1"
          }
        }
