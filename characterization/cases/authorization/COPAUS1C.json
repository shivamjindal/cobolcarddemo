{
  "feature": "pending-auth-detail",
  "kind": "online",
  "programs": [
    "COPAUS1C",
    "COPAUS2C"
  ],
  "install": [
    "pending-authorizations"
  ],
  "notes": "Pinned legacy behavior: AUTHCD shows PA-PROCESSING-CODE (COPAUS1C line 331), not the authorization id code. COPAUS2C builds AUTH-TS from PA-AUTH-ORIG-DATE and the complement of PA-AUTH-TIME-9C, so the AUTHFRDS timestamp time differs from AUTHTM, which shows PA-AUTH-ORIG-TIME. Marking fraud a second time removes it: COPAUS2C's INSERT gets SQLCODE -803 and falls back to UPDATE.",
