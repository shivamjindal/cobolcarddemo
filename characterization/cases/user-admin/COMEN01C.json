      "id": "main-menu-first-display",
      "title": "A regular user lands on the main menu listing 11 options",
      "provenance": "observed",
      "source": "COMEN01C MAIN-PARA, SEND-MENU-SCREEN",
      "steps": [
        {
          "do": {
            "transid": "CC00"
          }
        },
        {
          "do": {
            "aid": "ENTER",
