    {
      "id": "admin-menu-first-display",
      "title": "An admin lands on the admin menu listing 6 options",
      "provenance": "observed",
      "source": "COADM01C MAIN-PARA",
      "steps": [
        {
          "do": {
            "transid": "CC00"
          }
        },
        {
          "do": {
            "aid": "ENTER",
            "fields": {
              "USERID": "ADMIN001",
              "PASSWD": "PASSWORD"
            }
          },
          "expect": {
            "map": "COADM1A",
            "fields": {
              "TRNNAME": "CA00",
              "PGMNAME": "COADM01C",
              "OPTN001": "01. User List (Security)",
              "OPTN002": "02. User Add (Security)",
              "OPTN003": "03. User Update (Security)",
              "OPTN004": "04. User Delete (Security)",
              "OPTN005": "05. Transaction Type List/Update (Db2)",
              "OPTN006": "06. Transaction Type Maintenance (Db2)"
            },
            "cursor": "OPTION"
          }
        }
      ]
    },
