{
  "feature": "signon",
  "kind": "online",
  "programs": ["COSGN00C"],
  "cases": [
    {
      "id": "signon-first-display",
      "title": "CC00 on a clear screen shows the sign-on map with the cursor on User ID",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl MAIN-PARA (EIBCALEN = 0)",
      "steps": [
        {"do": {"transid": "CC00"},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "PASSWD": "________"}, "cursor": "USERID"}}
      ]
    },
    {
      "id": "signon-blank-userid",
      "title": "ENTER with nothing typed: User ID is checked first",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl PROCESS-ENTER-KEY",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "ENTER"},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "PASSWD": "________", "ERRMSG": "Please enter User ID ..."}, "cursor": "USERID"}}
      ]
    },
    {
      "id": "signon-blank-password",
      "title": "User ID typed and the password field erased",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl PROCESS-ENTER-KEY",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "ENTER", "fields": {"USERID": "USER0001", "PASSWD": ""}},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "USERID": "USER0001", "PASSWD": "________", "ERRMSG": "Please enter Password ..."}, "cursor": "PASSWD"}}
      ]
    },
    {
      "id": "signon-untouched-password",
      "title": "Password field left as shown: the FSET underscores are sent and fail as a wrong password",
      "provenance": "observed",
      "source": "app/bms/COSGN00.bms PASSWD ATTRB=(DRK,FSET,UNPROT) INITIAL='________'; app/cbl/COSGN00C.cbl READ-USER-SEC-FILE",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "ENTER", "fields": {"USERID": "USER0001"}},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "USERID": "USER0001", "PASSWD": "________", "ERRMSG": "Wrong Password. Try again ..."}, "cursor": "PASSWD"}}
      ]
    },
    {
      "id": "signon-unknown-user",
      "title": "User ID not in USRSEC",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl READ-USER-SEC-FILE (RESP 13)",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "ENTER", "fields": {"USERID": "nobody", "PASSWD": "secret"}},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "USERID": "nobody", "PASSWD": "secret", "ERRMSG": "User not found. Try again ..."}, "cursor": "USERID"}}
      ]
    },
    {
      "id": "signon-wrong-password",
      "title": "Known user, wrong password",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl READ-USER-SEC-FILE",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "ENTER", "fields": {"USERID": "USER0001", "PASSWD": "WRONG"}},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "USERID": "USER0001", "PASSWD": "WRONG", "ERRMSG": "Wrong Password. Try again ..."}, "cursor": "PASSWD"}}
      ]
    },
    {
      "id": "signon-admin-routes-to-admin-menu",
      "title": "User type A goes to the admin menu; ID and password are case-insensitive",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl READ-USER-SEC-FILE (CDEMO-USRTYP-ADMIN)",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "ENTER", "fields": {"USERID": "admin001", "PASSWD": "password"}},
         "expect": {"map": "COADM1A", "fields": {"TRNNAME": "CA00", "PGMNAME": "COADM01C",
           "OPTN001": "01. User List (Security)", "OPTN002": "02. User Add (Security)",
           "OPTN003": "03. User Update (Security)", "OPTN004": "04. User Delete (Security)",
           "OPTN005": "05. Transaction Type List/Update (Db2)", "OPTN006": "06. Transaction Type Maintenance (Db2)"},
           "cursor": "OPTION"}}
      ]
    },
    {
      "id": "signon-pf3-ends-session",
      "title": "PF3 on the sign-on screen says goodbye and frees the terminal",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl MAIN-PARA (DFHPF3), app/cpy/CSMSG01Y.cpy CCDA-MSG-THANK-YOU",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "PF3"},
         "expect": {"text": "Thank you for using CardDemo application...", "session": "ended"}}
      ]
    },
    {
      "id": "signon-invalid-key",
      "title": "Any key other than ENTER or PF3 redisplays with the invalid-key message",
      "provenance": "observed",
      "source": "app/cbl/COSGN00C.cbl MAIN-PARA (WHEN OTHER)",
      "steps": [
        {"do": {"transid": "CC00"}},
        {"do": {"aid": "PF5"},
         "expect": {"map": "COSGN0A", "fields": {"TRNNAME": "CC00", "PGMNAME": "COSGN00C", "PASSWD": "________", "ERRMSG": "Invalid key pressed. Please see below..."}, "cursor": "USERID"}}
      ]
    }
  ]
}
