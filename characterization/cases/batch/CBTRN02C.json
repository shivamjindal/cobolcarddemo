{
  "feature": "batch-posting",
  "kind": "batch",
  "programs": [
    "CBTRN02C"
  ],
  "notes": "TRANSACT starts empty: POSTTRAN opens TRANFILE OUTPUT, which follows the TRANBKP delete/define.",
  "cases": [
    {
      "id": "posting-valid-purchase",
      "title": "A valid purchase is written to TRANSACT and updates the account and category balance",
      "provenance": "observed",
      "source": "CBTRN02C 1500-VALIDATE-TRAN / 2000-POST-TRANSACTION",
      "setup": {
        "TRANSACT": {
          "replace": []
        },
        "DALYTRAN": {
          "replace": [
            {
              "DALYTRAN-ID": "T000000000000001",
              "DALYTRAN-TYPE-CD": "01",
              "DALYTRAN-CAT-CD": 1,
              "DALYTRAN-SOURCE": "POS TERM",
              "DALYTRAN-DESC": "Purchase at Harness Store",
              "DALYTRAN-AMT": "50.25",
              "DALYTRAN-MERCHANT-ID": 800000001,
              "DALYTRAN-MERCHANT-NAME": "Harness Store",
              "DALYTRAN-MERCHANT-CITY": "Springfield",
              "DALYTRAN-MERCHANT-ZIP": "12345",
              "DALYTRAN-CARD-NUM": "9680294154603697",
              "DALYTRAN-ORIG-TS": "2025-01-15 12:00:00.000000"
            }
          ]
        }
      },
      "job": {
        "program": "CBTRN02C",
        "dd": {
          "DALYTRAN": "DALYTRAN",
          "TRANFILE": "TRANSACT",
          "XREFFILE": "CARDXREF",
          "DALYREJS": {
            "output": "DALYREJS",
            "reclen": 430
          },
          "ACCTFILE": "ACCTDATA",
          "TCATBALF": "TCATBALF"
        }
      },
      "expect": {
        "completion": "RC=0",
        "sysout": [
          "START OF EXECUTION OF PROGRAM CBTRN02C",
          "TRANSACTIONS PROCESSED :000000001",
          "TRANSACTIONS REJECTED  :000000000",
          "END OF EXECUTION OF PROGRAM CBTRN02C"
        ],
        "files": {
          "ACCTDATA": {
            "updated": [
              {
                "key": "00000000001",
                "changed": {
                  "ACCT-CURR-BAL": [
                    "194.00",
                    "244.25"
                  ],
                  "ACCT-CURR-CYC-CREDIT": [
                    "0.00",
                    "50.25"
                  ]
                }
              }
            ]
          },
          "TRANSACT": {
            "inserted": [
              {
                "TRAN-ID": "T000000000000001",
                "TRAN-TYPE-CD": "01",
                "TRAN-CAT-CD": "1",
                "TRAN-SOURCE": "POS TERM",
                "TRAN-DESC": "Purchase at Harness Store",
                "TRAN-AMT": "50.25",
                "TRAN-MERCHANT-ID": "800000001",
                "TRAN-MERCHANT-NAME": "Harness Store",
                "TRAN-MERCHANT-CITY": "Springfield",
                "TRAN-MERCHANT-ZIP": "12345",
                "TRAN-CARD-NUM": "9680294154603697",
                "TRAN-ORIG-TS": "2025-01-15 12:00:00.000000",
                "TRAN-PROC-TS": "2026-11-05-10.00.00.000000"
              }
            ]
          },
          "TCATBALF": {
            "updated": [
              {
                "key": "00000000001010001",
                "changed": {
                  "TRAN-CAT-BAL": [
                    "0.00",
                    "50.25"
                  ]
                }
              }
            ]
          }
        },
        "outputs": {
          "DALYREJS": []
        }
      }
