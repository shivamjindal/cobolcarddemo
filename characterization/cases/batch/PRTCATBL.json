      "source": "PRTCATBL STEP10R OUTREC",
      "setup": {
        "TCATBALF": {
          "replace": [
            {
              "TRANCAT-ACCT-ID": "00000000001",
              "TRANCAT-TYPE-CD": "01",
              "TRANCAT-CD": "0001",
