    {
      "id": "account-view-first-display",
      "title": "Menu option 1 shows the empty account view with the input prompt and the cursor on the account field",
      "provenance": "observed",
      "source": "app/cbl/COACTVWC.cbl 0000-MAIN (CDEMO-PGM-ENTER), 1000-SEND-MAP",
      "steps": [
        {
          "do": {
            "transid": "CC00"
          }
        },
        {
          "do": {
            "aid": "ENTER",
            "fields": {
              "USERID": "USER0001",
              "PASSWD": "PASSWORD"
            }
          }
        },
        {
          "do": {
            "aid": "ENTER",
            "fields": {
              "OPTION": "1"
            }
          },
          "expect": {
            "map": "CACTVWA",
            "fields": {
              "TRNNAME": "CAVW",
              "PGMNAME": "COACTVWC",
              "INFOMSG": "Enter or update id of account to display"
            },
            "cursor": "ACCTSID"
          }
        }
      ]
    },
